# Local Henge bridge; credentials stay server-side.
HENGE_BACKEND_URL=http://127.0.0.1:8766
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_ROOT=/data/henge-comfy-backend
HENGE_DATA_DIR=/data/henge-data
# Optional external VLM. Without these, planning uses the local ComfyUI VLM.
VLM_CHAT_URL=
VLM_MODEL=
VLM_API_KEY=
# Optional local ComfyUI VLM checkpoint override; use the exact installed filename.
# Example matching the recent local workflow: qwen3.5_9b_w4a8_gptq.safetensors
HENGE_VLM_CLIP=qwen3.5_9b_w4a8_gptq.safetensors

# Optional local Molmo2 (find people from photos / point at targets); see docs/molmo-pointing.md.
HENGE_MOLMO_PYTHON=
HENGE_MOLMO_MODEL=

# Optional: GPU on RunPod Serverless instead of a ComfyUI (README option C).
# HENGE_BACKEND=runpod
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=

# Optional login for the whole UI (recommended on any address other than localhost).
# HENGE_USER=henge
# HENGE_PASSWORD=

# Optional: extra hosts allowed to open `npm run dev` (comma list), e.g. your LAN IP or a private tunnel name.
# Only needed for development from another device; `npm run start` does not use it.
# HENGE_DEV_ORIGINS=192.168.1.20,my-machine.example.ts.net
