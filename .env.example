# Local Kagemane bridge; credentials stay server-side.
KAGEMANE_BACKEND_URL=http://127.0.0.1:8766
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_ROOT=/data/kagemane-comfy-backend
KAGEMANE_DATA_DIR=/data/kagemane-data
# Optional external VLM. Without these, planning uses the local ComfyUI VLM.
VLM_CHAT_URL=
VLM_MODEL=
VLM_API_KEY=
# Optional local ComfyUI VLM checkpoint override; use the exact installed filename.
# Example matching the recent local workflow: qwen3.5_9b_w4a8_gptq.safetensors
KAGEMANE_VLM_CLIP=qwen3-vl-4b-heretic_int8_dynamic_convrot.safetensors
